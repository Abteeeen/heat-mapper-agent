# Copy to .env and fill in your keys. Never commit the real .env file.

# --- Step 1: property data provider ---
# "rentcast" (recommended, free tier) or "rapidapi_realtymole" (legacy)
REALTY_PROVIDER=rentcast

# Required if REALTY_PROVIDER=rentcast. Free tier: 50 requests/month, no
# credit card. Sign up at https://app.rentcast.io/app/api
RENTCAST_API_KEY=

# Required if REALTY_PROVIDER=rapidapi_realtymole.
RAPIDAPI_KEY=

# --- Steps 3 & 4: Google Geocoding / Static Maps / Street View ---
# One key with Geocoding API, Maps Static API, and Street View Static API enabled.
GOOGLE_MAPS_API_KEY=

# --- Step 5: OpenRouter (vision model) ---
OPENROUTER_API_KEY=
VISION_MODEL=anthropic/claude-3.5-sonnet

# --- Optional tuning ---
# Skip properties whose last sale is older than this many days.
MAX_DAYS_SINCE_SALE=180
REQUEST_TIMEOUT_SECONDS=30
